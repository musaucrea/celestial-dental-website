  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What are your opening hours?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We are open every day of the week. Kasarani, Kamakis and Eldoret are open 07:00 to 20:00, and Kiambu Road 08:00 to 18:00. Walk-ins are welcome, but booking ahead helps us reserve time for you."
        }
      },
      {
        "@type": "Question",
        "name": "Do you accept insurance and medical schemes?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. We work with a wide range of insurers and medical schemes including Jubilee, AAR, Madison, CIC, Britam, APA, SHA, NHIF and many more. Bring your insurance card and our team will handle pre-authorisation and billing."
        }
      },
      {
        "@type": "Question",
        "name": "Do you accept M-Pesa?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, we accept M-Pesa, cash, and direct insurance billing. For M-Pesa payments, our team at each branch will provide the till number at reception."
        }
      },
      {
        "@type": "Question",
        "name": "Is there a dentist open on Sunday in Nairobi?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Celestial Dental is open every day of the week, including Sundays and public holidays, at all four branches: 07:00 to 20:00 in Kasarani, Kamakis and Eldoret, and 08:00 to 18:00 on Kiambu Road."
        }
      },
      {
        "@type": "Question",
        "name": "Do you handle dental emergencies?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Call or WhatsApp the nearest branch and we aim to see you the same day. For severe pain or swelling, come in directly and our team will prioritise you."
        }
      },
      {
        "@type": "Question",
        "name": "Do you treat children?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. We offer gentle children's dentistry in a calm, child-friendly setting. We recommend a first visit as soon as the first tooth appears, or by age one."
        }
      }
    ]
  }
